# ---------- Supabase ----------
# One project holds both the metadata (Postgres) and the PDFs (Storage).
# Free tier: 1 GB storage + 5 GB egress/month, no credit card required.
# Values are in Project Settings > API.

# Server-only. The service-role key bypasses RLS and signs uploads/downloads.
# NEVER expose it to the browser — it is used only inside the /api routes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Exposed to the browser (that's fine — the anon key is designed to be public).
# Used by the client only to complete the signed upload.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Storage bucket name. Must match on both sides; defaults to "documents".
SUPABASE_STORAGE_BUCKET=documents
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=documents
