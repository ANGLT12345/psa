# ---------- Cloudflare R2 (PDF storage) ----------
# Create an R2 bucket, then an R2 API token (Account > R2 > Manage API Tokens).
# The account ID is in the R2 dashboard / bucket endpoint.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=the-archive

# ---------- Supabase (metadata) ----------
# Project Settings > API. The service-role key is SERVER-ONLY — never expose it
# to the browser. It is used only inside the /api routes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
