# ---------- Supabase ----------
# One project holds both the metadata (Postgres) and the PDFs (Storage).
# Free tier: 1 GB storage + 5 GB egress/month, no credit card required.
# Values are in Project Settings > API.
#
# All three are server-only — the browser never needs Supabase credentials,
# because uploads and views go through short-lived signed URLs minted here.

# Project URL, e.g. https://abcdefgh.supabase.co  (must include https://)
SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role "secret" key. It bypasses RLS and signs uploads/downloads.
# NEVER expose it to the browser — it is used only inside the /api routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket name. Defaults to "documents" if omitted.
SUPABASE_STORAGE_BUCKET=documents
