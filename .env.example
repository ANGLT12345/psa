# ---------- Supabase (server) ----------
# One project holds both the metadata (Postgres) and the PDFs (Storage).
# Free tier: 1 GB storage + 5 GB egress/month, no credit card required.
# Values are in Project Settings > API.

# Project URL, e.g. https://abcdefgh.supabase.co  (must include https://)
SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role "secret" key — bypasses RLS, signs uploads/downloads.
# SERVER-ONLY. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket name. Defaults to "documents" if omitted.
SUPABASE_STORAGE_BUCKET=documents

# ---------- Admin access ----------
# Comma-separated list of emails allowed to sign in at /admin and upload.
# Anyone else is rejected by the server even if they log in.
ADMIN_EMAILS=you@example.com,teammate@example.com

# ---------- Supabase (browser, admin login only) ----------
# Used ONLY by the /admin page for email magic-link login. Safe to expose —
# the anon key is designed to be public. The public catalogue uses neither.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
